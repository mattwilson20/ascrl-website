
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>iRacing Stats | American Stock Car Racing League</title>
    <link rel="icon" href="https://cdn.discordapp.com/emojis/1445100562960879760.png?size=96" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="style.css" />

    <style>
        :root {
            --primary: #c00;
            --accent: #ff0;
            --bg-dark: #050505;
            --card-bg: #111;
            --panel: #0b0f13;
            --panel-2: #07131d;
            --border: #222;
            --text-muted: #888;
            --ir-blue: #00f0ff;
            --ir-blue-dark: #004466;
            --good: #00ff88;
            --bad: #ff4040;
            --gold: #ffd700;
            --transition: 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: 'Arial Black', sans-serif;
            background-color: #080808;
            color: #fff;
            overflow-x: hidden;
            background-image:
                radial-gradient(circle at 50% 0%, rgba(0, 240, 255, 0.09), transparent 28rem),
                radial-gradient(circle at 100% 15%, rgba(204, 0, 0, 0.12), transparent 26rem),
                linear-gradient(to bottom, rgba(0,0,0,0.25), rgba(0,0,0,0.96)),
                url("https://www.transparenttextures.com/patterns/carbon-fibre.png");
            background-attachment: fixed;
        }

        #nav-placeholder { position: relative; z-index: 9999; }

        .ir-hero {
            min-height: 70vh;
            padding: 8rem 1rem 4rem;
            display: grid;
            place-items: center;
            text-align: center;
            position: relative;
            overflow: hidden;
            border-bottom: 1px solid var(--border);
            background:
                linear-gradient(180deg, rgba(0,0,0,0.25), #080808 92%),
                repeating-linear-gradient(90deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 80px),
                repeating-linear-gradient(0deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 80px);
        }

        .ir-hero::before {
            content: "";
            position: absolute;
            inset: -20% -10% auto -10%;
            height: 68%;
            background: radial-gradient(circle, rgba(0,240,255,0.22), transparent 58%);
            filter: blur(40px);
            opacity: 0.75;
            pointer-events: none;
        }

        .hero-inner { position: relative; z-index: 2; max-width: 1150px; }
        .eyebrow { color: var(--ir-blue); letter-spacing: 6px; text-transform: uppercase; font-size: 0.78rem; text-shadow: 0 0 18px rgba(0,240,255,0.5); }
        h1 { font-size: clamp(3.2rem, 10vw, 8rem); line-height: 0.85; margin: 0.75rem 0; letter-spacing: -4px; text-transform: uppercase; }
        .text-gradient { background: linear-gradient(to bottom, #fff 25%, #7f8d99 55%, #161616 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .hero-copy { max-width: 760px; margin: 1.2rem auto 0; color: #b9c6cc; font-family: Arial, sans-serif; font-weight: 700; line-height: 1.65; }

        .hero-actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 2rem; }
        .btn {
            border: 1px solid #333;
            background: #111;
            color: #fff;
            font-family: 'Arial Black', sans-serif;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 13px 18px;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            display: inline-flex;
            gap: 10px;
            align-items: center;
            justify-content: center;
        }
        .btn:hover { transform: translateY(-2px); border-color: var(--ir-blue); color: var(--ir-blue); box-shadow: 0 0 20px rgba(0,240,255,0.18); }
        .btn-primary { background: #001122; border-color: var(--ir-blue-dark); }
        .btn-danger { background: #190707; border-color: #4a1010; }
        .btn-danger:hover { border-color: var(--primary); color: #fff; box-shadow: 0 0 20px rgba(204,0,0,0.25); }

        .container { max-width: 1400px; margin: 0 auto; padding: 2.5rem 1rem 5rem; }
        .panel {
            background: linear-gradient(180deg, rgba(17,17,17,0.94), rgba(6,6,6,0.96));
            border: 1px solid var(--border);
            box-shadow: 0 18px 50px rgba(0,0,0,0.38);
        }

        .setup-panel { margin-top: -4rem; position: relative; z-index: 5; padding: 1rem; }
        .setup-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 1rem; align-items: stretch; }
        .drop-zone {
            border: 1px dashed #2b5966;
            background: linear-gradient(135deg, rgba(0,240,255,0.08), rgba(204,0,0,0.05));
            padding: 1.5rem;
            min-height: 180px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 1rem;
            transition: var(--transition);
        }
        .drop-zone.dragover { border-color: var(--ir-blue); background: rgba(0,240,255,0.12); }
        .drop-title { font-size: clamp(1.2rem, 3vw, 2rem); text-transform: uppercase; margin: 0; }
        .drop-help { color: var(--text-muted); font-family: Arial, sans-serif; line-height: 1.5; margin: 0; }
        .file-input { display: none; }

        .manifest-card { padding: 1.5rem; background: #070707; border: 1px solid #1d1d1d; }
        .manifest-card code, .code-block { font-family: Consolas, Monaco, monospace; font-size: 0.78rem; color: #baf7ff; }
        .code-block { display: block; background: #020608; border: 1px solid #14262e; padding: 1rem; overflow: auto; margin-top: 0.8rem; white-space: pre; }

        .status-bar { margin-top: 1rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; color: #aaa; font-family: Arial, sans-serif; font-weight: 700; }
        .status-pill { border: 1px solid #26333a; background: #071016; color: #bcefff; padding: 8px 12px; border-radius: 999px; font-size: 0.85rem; }

        .controls-bar { position: sticky; top: 0; z-index: 120; background: rgba(8,8,8,0.95); backdrop-filter: blur(15px); border-bottom: 1px solid #222; padding: 1rem 0; }
        .controls-inner { max-width: 1400px; margin: 0 auto; padding: 0 1rem; display: grid; grid-template-columns: 1fr auto auto; gap: 10px; align-items: center; }
        select, input[type="search"] {
            background: #111;
            color: #fff;
            border: 1px solid #333;
            padding: 12px 14px;
            font-family: 'Arial Black', sans-serif;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            min-height: 46px;
        }
        input[type="search"] { font-family: Arial, sans-serif; text-transform: none; font-weight: 800; }
        select:focus, input[type="search"]:focus { outline: none; border-color: var(--ir-blue); }
        .view-tabs { display: flex; gap: 7px; flex-wrap: wrap; justify-content: flex-end; }
        .tab-btn { background: transparent; color: #777; border: 1px solid #333; padding: 12px 14px; font-family: 'Arial Black'; cursor: pointer; text-transform: uppercase; transition: 0.25s; }
        .tab-btn.active, .tab-btn:hover { color: #000; background: var(--ir-blue); border-color: var(--ir-blue); }

        .kpi-grid { display: grid; grid-template-columns: repeat(6, minmax(140px, 1fr)); gap: 1rem; margin: 2rem 0; }
        .kpi { padding: 1.15rem; border: 1px solid #202020; background: linear-gradient(180deg, #101010, #080808); position: relative; overflow: hidden; }
        .kpi::after { content: ""; position: absolute; inset: auto 0 0 0; height: 3px; background: linear-gradient(90deg, var(--primary), var(--ir-blue)); opacity: 0.8; }
        .kpi-label { color: #777; font-size: 0.68rem; letter-spacing: 2px; text-transform: uppercase; }
        .kpi-value { font-size: 1.75rem; margin-top: 0.4rem; line-height: 1; }

        .section-title { display: flex; align-items: center; gap: 14px; margin: 2.5rem 0 1rem; text-transform: uppercase; color: #fff; letter-spacing: 1px; }
        .section-title::after { content: ""; flex: 1; height: 1px; background: #222; }
        .section-title span { color: var(--ir-blue); }

        .dashboard-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 1rem; }
        .card { background: #0c0c0c; border: 1px solid #222; padding: 1rem; min-height: 180px; }
        .race-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 1rem; }
        .race-card { cursor: pointer; min-height: 220px; display: flex; flex-direction: column; justify-content: space-between; transition: var(--transition); position: relative; overflow: hidden; }
        .race-card::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at top right, rgba(0,240,255,0.09), transparent 55%); pointer-events: none; }
        .race-card:hover { transform: translateY(-6px); border-color: var(--ir-blue); box-shadow: 0 15px 45px rgba(0,240,255,0.10); }
        .race-card.active { border-color: var(--primary); box-shadow: 0 0 0 1px var(--primary) inset; }
        .race-round { color: var(--ir-blue); font-size: 0.72rem; letter-spacing: 2px; text-transform: uppercase; }
        .race-name { font-size: 1.35rem; margin: 0.65rem 0 0.25rem; text-transform: uppercase; line-height: 1.1; }
        .race-meta { color: #777; font-family: Arial, sans-serif; font-weight: 800; font-size: 0.85rem; line-height: 1.45; }
        .winner-chip { margin-top: 1rem; display: inline-flex; gap: 8px; align-items: center; color: #000; background: var(--gold); padding: 7px 10px; font-size: 0.72rem; text-transform: uppercase; }

        .table-wrapper { overflow-x: auto; background: #0b0b0b; border: 1px solid #222; }
        table { width: 100%; border-collapse: collapse; min-width: 860px; }
        th { background: #070707; color: #777; font-size: 0.68rem; letter-spacing: 2px; text-transform: uppercase; padding: 15px 10px; text-align: center; border-bottom: 1px solid #222; position: sticky; top: 0; z-index: 1; }
        th:nth-child(2), td:nth-child(2) { text-align: left; }
        td { padding: 14px 10px; border-bottom: 1px solid #1a1a1a; text-align: center; color: #cfcfcf; font-family: Arial, sans-serif; font-weight: 800; }
        tbody tr { cursor: pointer; transition: 0.2s; }
        tbody tr:hover { background: rgba(0,240,255,0.045); }
        .rank { font-family: 'Arial Black'; color: #555; font-size: 1.2rem; }
        .top3 .rank { color: var(--primary); }
        .driver-name { font-family: 'Arial Black'; color: #fff; text-transform: uppercase; }
        .muted { color: var(--text-muted); }
        .positive { color: var(--good); }
        .negative { color: var(--bad); }

        .viz-panel { padding: 1rem; }
        .svg-wrap { width: 100%; overflow: hidden; border: 1px solid #202020; background: #030607; }
        svg { width: 100%; height: auto; display: block; }
        .legend { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; font-family: Arial, sans-serif; font-weight: 800; color: #aaa; font-size: 0.82rem; }
        .legend span { border: 1px solid #222; padding: 6px 9px; background: #080808; }

        .event-feed { max-height: 360px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding-right: 4px; }
        .event-item { display: grid; grid-template-columns: 58px 1fr auto; gap: 10px; align-items: center; padding: 10px; background: #070707; border: 1px solid #1b1b1b; font-family: Arial, sans-serif; font-weight: 800; }
        .event-lap { color: var(--ir-blue); font-family: 'Arial Black'; }
        .event-tag { color: #000; background: var(--accent); padding: 4px 6px; font-family: 'Arial Black'; font-size: 0.68rem; text-transform: uppercase; }
        .event-tag.pitted { background: var(--ir-blue); }
        .event-tag.contact, .event-tag.car_contact { background: var(--bad); color: #fff; }
        .event-tag.invalid_lap, .event-tag.black_flag { background: #fff; color: #000; }

        .driver-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
        .driver-card { cursor: pointer; position: relative; overflow: hidden; min-height: 170px; }
        .driver-card:hover { border-color: var(--ir-blue); transform: translateY(-3px); }
        .number-watermark { position: absolute; right: 10px; bottom: -18px; font-size: 6rem; color: rgba(255,255,255,0.05); pointer-events: none; }
        .driver-card h3 { margin: 0; font-size: 1.2rem; text-transform: uppercase; }
        .driver-card .small { color: #888; font-family: Arial, sans-serif; font-weight: 900; font-size: 0.82rem; margin-top: 0.4rem; }

        .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.94); z-index: 20000; overflow-y: auto; padding: 2rem 1rem; }
        .modal.open { display: block; }
        .modal-card { max-width: 1100px; margin: 0 auto; background: #080808; border: 1px solid var(--ir-blue-dark); box-shadow: 0 0 60px rgba(0,240,255,0.16); }
        .modal-header { padding: 2rem; background: linear-gradient(135deg, rgba(0,240,255,0.12), rgba(204,0,0,0.08)); border-bottom: 1px solid #222; display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
        .modal-header h2 { margin: 0; font-size: clamp(2rem, 6vw, 4rem); line-height: 0.9; text-transform: uppercase; }
        .close { background: #111; border: 1px solid #333; color: #fff; font-size: 1.5rem; width: 46px; height: 46px; cursor: pointer; }
        .modal-body { padding: 1rem; }

        .empty-state { text-align: center; padding: 3rem 1rem; color: #777; font-family: Arial, sans-serif; font-weight: 800; border: 1px dashed #333; background: rgba(255,255,255,0.02); }
        .hidden { display: none !important; }

        footer { padding: 4rem 1rem; text-align: center; border-top: 1px solid var(--border); color: #333; font-size: 0.8rem; letter-spacing: 2px; text-transform: uppercase; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
        .social-links { display: flex; gap: 2rem; justify-content: center; }
        .social-icon { color: #555; font-size: 1.8rem; transition: 0.3s ease; display: flex; align-items: center; justify-content: center; text-decoration: none; }
        .social-icon:hover { transform: translateY(-3px); color: #fff; }

        @media (max-width: 1000px) {
            .setup-grid, .dashboard-grid, .controls-inner { grid-template-columns: 1fr; }
            .view-tabs { justify-content: flex-start; }
            .kpi-grid { grid-template-columns: repeat(2, minmax(130px, 1fr)); }
            .ir-hero { min-height: 55vh; padding-top: 7rem; }
        }
        @media (max-width: 560px) {
            .kpi-grid { grid-template-columns: 1fr; }
            .setup-panel { margin-top: -2rem; }
            .event-item { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div id="nav-placeholder"></div>

    <header class="ir-hero">
        <div class="hero-inner">
            <div class="eyebrow">Sim Racing Series • Official Data Center</div>
            <h1 class="text-gradient">ASCRL iRACING</h1>
            <p class="hero-copy">Race results, lap charts, lead changes, incidents, pit cycles, driver profiles, and season standings built from iRacing JSON exports. Drop this page into your existing GitHub site as <strong>iracing.html</strong>.</p>
            <div class="hero-actions">
                <button class="btn btn-primary" onclick="document.getElementById('jsonFiles').click()"><i class="fa-solid fa-file-import"></i> Test Upload JSONs</button>
                <button class="btn" onclick="loadManifest()"><i class="fa-solid fa-cloud-arrow-down"></i> Load Public Manifest</button>
                <a class="btn" href="#how-to-add-races"><i class="fa-solid fa-list-check"></i> Race-by-Race Setup</a>
            </div>
        </div>
    </header>

    <main class="container">
        <section class="setup-panel panel" id="how-to-add-races">
            <div class="setup-grid">
                <div class="drop-zone" id="dropZone">
                    <input id="jsonFiles" class="file-input" type="file" accept=".json,application/json" multiple />
                    <h2 class="drop-title"><i class="fa-solid fa-cloud-arrow-up" style="color:var(--ir-blue)"></i> Upload race JSONs while testing</h2>
                    <p class="drop-help">Select or drag in matching iRacing files: one <strong>event result</strong> JSON and one <strong>lap chart</strong> JSON per race. The page pairs them automatically by <strong>subsession_id</strong>.</p>
                    <div>
                        <button class="btn btn-primary" onclick="document.getElementById('jsonFiles').click()">Choose JSON files</button>
                        <button class="btn btn-danger" onclick="clearData()">Clear loaded data</button>
                    </div>
                </div>
                <div class="manifest-card">
                    <div class="eyebrow" style="letter-spacing:3px;font-size:.65rem;">Best public GitHub setup</div>
                    <p class="drop-help">Do not stack every race into one huge JSON. Use one folder per race and one manifest that lists the files.</p>
                    <code class="code-block">data/iracing/season-manifest.json

data/iracing/2026-s1/race-01-talladega/
  eventresult-85503415.json
  iracing-lap-chart-85503415.json</code>
                </div>
            </div>
            <div class="status-bar">
                <span id="loadStatus" class="status-pill">Ready. Upload files or add data/iracing/season-manifest.json.</span>
                <span class="muted">Expected manifest path: <code>data/iracing/season-manifest.json</code></span>
            </div>
        </section>

        <section class="kpi-grid" id="kpiGrid"></section>
    </main>

    <div class="controls-bar">
        <div class="controls-inner">
            <input type="search" id="searchInput" placeholder="Search driver, track, car number..." oninput="renderAll()" />
            <select id="seasonSelect" onchange="onSeasonChange()"></select>
            <div class="view-tabs">
                <button class="tab-btn active" data-view="overview" onclick="switchView('overview')">Overview</button>
                <button class="tab-btn" data-view="races" onclick="switchView('races')">Races</button>
                <button class="tab-btn" data-view="standings" onclick="switchView('standings')">Standings</button>
                <button class="tab-btn" data-view="drivers" onclick="switchView('drivers')">Drivers</button>
            </div>
        </div>
    </div>

    <main class="container">
        <section id="overviewView">
            <h2 class="section-title"><span>01</span> Command Center</h2>
            <div class="dashboard-grid">
                <div class="card viz-panel">
                    <h3 style="margin-top:0;">Selected Race Position Chart</h3>
                    <div id="positionChart" class="svg-wrap"></div>
                    <div id="chartLegend" class="legend"></div>
                </div>
                <div class="card">
                    <h3 style="margin-top:0;">Race Event Feed</h3>
                    <div id="eventFeed" class="event-feed"></div>
                </div>
            </div>

            <h2 class="section-title"><span>02</span> Latest Races</h2>
            <div id="latestRaces" class="race-grid"></div>
        </section>

        <section id="racesView" class="hidden">
            <h2 class="section-title"><span>03</span> Race Archive</h2>
            <div id="raceGrid" class="race-grid"></div>
            <h2 class="section-title"><span>04</span> Selected Race Results</h2>
            <div id="raceResultsTable" class="table-wrapper"></div>
        </section>

        <section id="standingsView" class="hidden">
            <h2 class="section-title"><span>05</span> Season Standings</h2>
            <div id="standingsTable" class="table-wrapper"></div>
        </section>

        <section id="driversView" class="hidden">
            <h2 class="section-title"><span>06</span> Driver Garage</h2>
            <div id="driverGrid" class="driver-grid"></div>
        </section>
    </main>

    <div class="modal" id="driverModal" onclick="closeDriverModal(event)">
        <div class="modal-card" onclick="event.stopPropagation()">
            <div class="modal-header">
                <div>
                    <div class="eyebrow" id="modalEyebrow">Driver Profile</div>
                    <h2 id="modalName">Driver</h2>
                    <p class="drop-help" id="modalSub"></p>
                </div>
                <button class="close" onclick="document.getElementById('driverModal').classList.remove('open')">×</button>
            </div>
            <div class="modal-body">
                <div class="kpi-grid" id="modalKpis"></div>
                <h3>Race Log</h3>
                <div id="modalTable" class="table-wrapper"></div>
            </div>
        </div>
    </div>

    <footer>
        <div class="social-links">
            <a href="https://www.facebook.com/groups/455913060530838" target="_blank" class="social-icon facebook"><i class="fab fa-facebook-f"></i></a>
            <a href="https://twitter.com/ASCRL_AandM" target="_blank" class="social-icon x-twitter"><i class="fa-brands fa-x-twitter"></i></a>
            <a href="mailto:americanstockcarracingleague@gmail.com" class="social-icon email"><i class="fas fa-envelope"></i></a>
        </div>
        <span>© A&M Productions LLC • iRacing Data Center</span>
    </footer>

    <script>
        const MANIFEST_PATH = 'data/iracing/season-manifest.json';
        const state = {
            rawFiles: [],
            races: [],
            seasons: [],
            selectedSeason: 'all',
            selectedRaceId: null,
            view: 'overview'
        };

        const $ = (id) => document.getElementById(id);
        const safe = (v, fallback='—') => (v === null || v === undefined || v === '' ? fallback : v);
        const pos = (n) => Number.isFinite(+n) ? +n + 1 : '—';
        const fmtInt = (n) => Number.isFinite(+n) ? Number(n).toLocaleString() : '—';
        const fmtTime = (v) => {
            const n = Number(v);
            if (!Number.isFinite(n) || n <= 0) return '—';
            const sec = n / 10000;
            const minutes = Math.floor(sec / 60);
            const seconds = sec - minutes * 60;
            return `${minutes}:${seconds.toFixed(3).padStart(6, '0')}`;
        };
        const slug = (s) => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
        const html = (s) => String(s ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));

        function setStatus(message) { $('loadStatus').textContent = message; }

        fetch('nav.html')
            .then(r => r.ok ? r.text() : '')
            .then(data => {
                if (!data) return;
                $('nav-placeholder').innerHTML = data;
                const active = document.getElementById('nav-iracing');
                if (active) active.style.boxShadow = '0 0 24px rgba(0,240,255,.35)';
            })
            .catch(() => {});

        function toggleMenu() {
            const nav = document.getElementById('nav-menu');
            if (nav) nav.classList.toggle('open');
        }

        document.addEventListener('DOMContentLoaded', () => {
            setupUploads();
            seedEmpty();
            loadManifest(true);
        });

        function setupUploads() {
            $('jsonFiles').addEventListener('change', async (e) => readFiles([...e.target.files]));
            const dz = $('dropZone');
            ['dragenter','dragover'].forEach(evt => dz.addEventListener(evt, e => { e.preventDefault(); dz.classList.add('dragover'); }));
            ['dragleave','drop'].forEach(evt => dz.addEventListener(evt, e => { e.preventDefault(); dz.classList.remove('dragover'); }));
            dz.addEventListener('drop', e => readFiles([...e.dataTransfer.files].filter(f => f.name.toLowerCase().endsWith('.json'))));
        }

        async function readFiles(files) {
            if (!files.length) return;
            setStatus(`Reading ${files.length} JSON file(s)...`);
            const parsed = [];
            for (const file of files) {
                try {
                    parsed.push({ name: file.name, json: JSON.parse(await file.text()) });
                } catch (err) {
                    console.warn('Bad JSON:', file.name, err);
                }
            }
            ingestJsonPairs(parsed, 'Uploaded JSONs');
        }

        async function loadManifest(silent=false) {
            try {
                if (!silent) setStatus(`Loading ${MANIFEST_PATH}...`);
                const res = await fetch(MANIFEST_PATH, { cache: 'no-store' });
                if (!res.ok) throw new Error('manifest not found');
                const manifest = await res.json();
                const items = flattenManifest(manifest);
                if (!items.length) throw new Error('manifest has no races');
                setStatus(`Manifest found. Loading ${items.length} race(s)...`);
                const files = [];
                for (const race of items) {
                    const base = MANIFEST_PATH.replace(/[^/]+$/, '');
                    const eventUrl = base + race.event;
                    const lapUrl = base + race.lapChart;
                    const [eventJson, lapJson] = await Promise.all([fetchJson(eventUrl), fetchJson(lapUrl)]);
                    files.push({ name: race.event, json: eventJson, meta: race });
                    files.push({ name: race.lapChart, json: lapJson, meta: race });
                }
                ingestJsonPairs(files, manifest.league || 'Public manifest');
            } catch (err) {
                if (!silent) setStatus(`No public manifest loaded yet. Add ${MANIFEST_PATH} or use upload mode.`);
                seedEmpty();
            }
        }

        async function fetchJson(url) {
            const r = await fetch(url, { cache: 'no-store' });
            if (!r.ok) throw new Error(`Could not fetch ${url}`);
            return r.json();
        }

        function flattenManifest(manifest) {
            if (Array.isArray(manifest.races)) return manifest.races.map(r => ({ seasonId: manifest.seasonId || manifest.id || 'default', seasonName: manifest.seasonName || manifest.name || 'iRacing Season', ...r }));
            const out = [];
            for (const season of manifest.seasons || []) {
                for (const race of season.races || []) out.push({ seasonId: season.id, seasonName: season.name, ...race });
            }
            return out;
        }

        function ingestJsonPairs(files, sourceLabel) {
            const grouped = new Map();
            for (const file of files) {
                const json = file.json;
                const type = detectType(json);
                const sid = getSubsessionId(json);
                if (!sid) continue;
                if (!grouped.has(sid)) grouped.set(sid, { subsession_id: sid, event: null, lap: null, meta: file.meta || {} });
                const bucket = grouped.get(sid);
                if (type === 'event') bucket.event = json;
                if (type === 'lap') bucket.lap = json;
                bucket.meta = { ...bucket.meta, ...(file.meta || {}) };
            }

            const normalized = [...grouped.values()].map(normalizeRace).filter(Boolean);
            const existing = new Map(state.races.map(r => [r.subsession_id, r]));
            for (const r of normalized) existing.set(r.subsession_id, r);
            state.races = [...existing.values()].sort((a,b) => (a.date || '').localeCompare(b.date || '') || a.round - b.round);
            state.selectedRaceId = state.selectedRaceId || state.races.at(-1)?.subsession_id || null;
            rebuildSeasons();
            renderAll();
            setStatus(`${sourceLabel}: loaded ${normalized.length} paired race(s). Total races on page: ${state.races.length}.`);
        }

        function detectType(json) {
            if (json?.type === 'event_result' || json?.data?.session_results) return 'event';
            if (Array.isArray(json?.lapData)) return 'lap';
            return 'unknown';
        }
        function getSubsessionId(json) { return json?.data?.subsession_id || json?.subsession_id || json?.subSessionId || null; }

        function normalizeRace(pair) {
            const event = pair.event?.data || pair.event || {};
            const lap = pair.lap || {};
            const raceSession = (event.session_results || []).find(s => /race/i.test(s.simsession_name || s.simsession_type_name || '')) || (event.session_results || []).at(-1) || {};
            const results = (raceSession.results || []).map(r => ({
                cust_id: r.cust_id,
                display_name: r.display_name || r.name || `Driver ${r.cust_id}`,
                car_number: r.livery?.car_number || r.car_number || '',
                car_name: r.car_name || '',
                start: Number.isFinite(+r.starting_position) ? +r.starting_position + 1 : null,
                finish: Number.isFinite(+r.finish_position) ? +r.finish_position + 1 : Number.isFinite(+r.finish_position_in_class) ? +r.finish_position_in_class + 1 : null,
                laps: +r.laps_complete || 0,
                led: +r.laps_lead || 0,
                incidents: +r.incidents || 0,
                points: +r.champ_points || +r.league_points || 0,
                bestLap: +r.best_lap_time || -1,
                avgLap: +r.average_lap || -1,
                reason: r.reason_out || '—',
                oldIR: +r.oldi_rating || null,
                newIR: +r.newi_rating || null,
                livery: r.livery || {},
                helmet: r.helmet || {}
            })).sort((a,b) => (a.finish ?? 999) - (b.finish ?? 999));

            const laps = normalizeLapChart(lap.lapData || []);
            const winner = results[0] || null;
            const seasonId = pair.meta.seasonId || inferSeason(event, pair.meta);
            const seasonName = pair.meta.seasonName || event.season_name || seasonId;
            return {
                subsession_id: pair.subsession_id,
                seasonId,
                seasonName,
                round: +pair.meta.round || +event.race_week_num || state.races.length + 1,
                name: pair.meta.name || event.track?.track_name || event.track_name || event.event_type_name || `Race ${pair.subsession_id}`,
                date: pair.meta.date || event.start_time || event.launch_at || '',
                track: event.track?.track_name || pair.meta.track || pair.meta.name || 'Unknown Track',
                league: event.league_name || pair.meta.league || 'ASCRL iRacing',
                sof: event.event_strength_of_field || event.strength_of_field || event.car_classes?.[0]?.strength_of_field || null,
                cautions: event.num_cautions || 0,
                cautionLaps: event.num_caution_laps || 0,
                leadChanges: event.num_lead_changes || countLeadChanges(laps),
                totalLaps: Math.max(...results.map(r => r.laps), ...laps.map(l => l.lap_number), 0),
                entries: results.length || new Set(laps.map(l => l.cust_id)).size,
                results,
                laps,
                winner
            };
        }

        function inferSeason(event, meta) {
            if (event.season_name) return slug(event.season_name);
            const d = meta.date || event.start_time || '';
            return d ? d.slice(0,4) : 'uploaded';
        }

        function normalizeLapChart(lapData) {
            const out = [];
            lapData.forEach((row, rowIdx) => {
                Object.keys(row || {}).forEach(key => {
                    if (!key.startsWith('lap_')) return;
                    const rec = row[key];
                    if (!rec || rec.lap_number === undefined) return;
                    out.push({
                        lap_number: +rec.lap_number,
                        running_position: +rec.lap_position || rowIdx + 1,
                        cust_id: rec.cust_id,
                        display_name: rec.display_name || rec.name || `Driver ${rec.cust_id}`,
                        car_number: rec.car_number || '',
                        lap_time: +rec.lap_time || -1,
                        session_time: +rec.session_time || null,
                        flags: +rec.flags || 0,
                        incident: !!rec.incident,
                        events: Array.isArray(rec.lap_events) ? rec.lap_events : [],
                        fastest_lap: !!rec.fastest_lap,
                        personal_best_lap: !!rec.personal_best_lap
                    });
                });
            });
            return out.sort((a,b) => a.lap_number - b.lap_number || a.running_position - b.running_position);
        }

        function countLeadChanges(laps) {
            const leaders = laps.filter(l => l.running_position === 1).sort((a,b) => a.lap_number - b.lap_number);
            let changes = 0, last = null;
            for (const l of leaders) { if (last && last !== l.cust_id) changes++; last = l.cust_id; }
            return changes;
        }

        function rebuildSeasons() {
            const map = new Map();
            for (const r of state.races) if (!map.has(r.seasonId)) map.set(r.seasonId, r.seasonName || r.seasonId);
            state.seasons = [...map.entries()].map(([id,name]) => ({id, name}));
            if (!state.seasons.some(s => s.id === state.selectedSeason)) state.selectedSeason = 'all';
        }

        function selectedRaces() {
            const q = $('searchInput')?.value?.trim().toLowerCase() || '';
            return state.races.filter(r => {
                if (state.selectedSeason !== 'all' && r.seasonId !== state.selectedSeason) return false;
                if (!q) return true;
                return [r.name, r.track, r.winner?.display_name, ...r.results.map(x => `${x.display_name} ${x.car_number}`)].join(' ').toLowerCase().includes(q);
            });
        }

        function onSeasonChange() { state.selectedSeason = $('seasonSelect').value; state.selectedRaceId = selectedRaces().at(-1)?.subsession_id || state.races.at(-1)?.subsession_id || null; renderAll(); }
        function switchView(view) { state.view = view; document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.view === view)); renderAll(); }
        function selectRace(id) { state.selectedRaceId = id; switchView('races'); }
        function getSelectedRace() { return state.races.find(r => String(r.subsession_id) === String(state.selectedRaceId)) || selectedRaces().at(-1) || state.races.at(-1); }

        function renderAll() {
            renderSeasonSelect();
            ['overview','races','standings','drivers'].forEach(v => $(`${v}View`).classList.toggle('hidden', state.view !== v));
            renderKpis();
            renderRaces();
            renderSelectedRace();
            renderStandings();
            renderDrivers();
        }

        function renderSeasonSelect() {
            const sel = $('seasonSelect');
            const current = sel.value || state.selectedSeason;
            sel.innerHTML = `<option value="all">All iRacing Seasons</option>` + state.seasons.map(s => `<option value="${html(s.id)}">${html(s.name)}</option>`).join('');
            sel.value = state.seasons.some(s => s.id === current) ? current : state.selectedSeason;
        }

        function renderKpis() {
            const races = selectedRaces();
            const starts = races.reduce((a,r)=>a+r.results.length,0);
            const drivers = new Set(races.flatMap(r => r.results.map(x => x.cust_id))).size;
            const laps = races.reduce((a,r)=>a+r.totalLaps,0);
            const incidents = races.reduce((a,r)=>a+r.results.reduce((s,x)=>s+x.incidents,0),0);
            const leadChanges = races.reduce((a,r)=>a+r.leadChanges,0);
            const avgSof = races.length ? Math.round(races.reduce((a,r)=>a+(+r.sof || 0),0)/races.length) : 0;
            const data = [
                ['Races', races.length], ['Driver Starts', starts], ['Unique Drivers', drivers], ['Race Laps', laps], ['Incidents', incidents], ['Avg SOF', avgSof]
            ];
            $('kpiGrid').innerHTML = data.map(([label,value]) => `<div class="kpi"><div class="kpi-label">${label}</div><div class="kpi-value">${fmtInt(value)}</div></div>`).join('');
        }

        function renderRaces() {
            const races = selectedRaces().sort((a,b) => (b.date || '').localeCompare(a.date || '') || b.round - a.round);
            const cards = races.map(r => raceCardHtml(r)).join('') || `<div class="empty-state">No races loaded yet. Upload JSONs or add a public manifest.</div>`;
            $('raceGrid').innerHTML = cards;
            $('latestRaces').innerHTML = races.slice(0, 6).map(r => raceCardHtml(r)).join('') || `<div class="empty-state">No latest races yet.</div>`;
        }
        function raceCardHtml(r) {
            const active = String(r.subsession_id) === String(state.selectedRaceId) ? ' active' : '';
            return `<article class="card race-card${active}" onclick="selectRace(${Number(r.subsession_id)})">
                <div>
                    <div class="race-round">Round ${html(r.round)} • ${html(r.seasonName)}</div>
                    <h3 class="race-name">${html(r.name)}</h3>
                    <div class="race-meta">${html(r.track)}<br>${html((r.date || '').slice(0,10) || 'Date TBD')} • ${fmtInt(r.entries)} entries • ${fmtInt(r.totalLaps)} laps</div>
                </div>
                <div>
                    <span class="winner-chip"><i class="fa-solid fa-trophy"></i> ${html(r.winner?.display_name || 'Winner TBD')}</span>
                </div>
            </article>`;
        }

        function renderSelectedRace() {
            const race = getSelectedRace();
            if (!race) {
                $('raceResultsTable').innerHTML = `<div class="empty-state">Select a race to view results.</div>`;
                $('positionChart').innerHTML = `<div class="empty-state">No lap chart loaded yet.</div>`;
                $('eventFeed').innerHTML = `<div class="empty-state">No events loaded yet.</div>`;
                return;
            }
            $('raceResultsTable').innerHTML = resultsTable(race.results, true);
            renderPositionChart(race);
            renderEventFeed(race);
        }

        function resultsTable(rows, includeRace=false) {
            return `<table><thead><tr>
                <th>Fin</th><th>Driver</th><th>#</th><th>Start</th><th>Laps</th><th>Led</th><th>Inc</th><th>Pts</th><th>Best</th><th>Avg</th><th>iR Δ</th><th>Reason</th>
            </tr></thead><tbody>${rows.map((r,i) => {
                const delta = (r.newIR && r.oldIR) ? r.newIR - r.oldIR : null;
                return `<tr class="${i<3?'top3':''}" onclick="openDriver(${Number(r.cust_id)})">
                    <td class="rank">${html(r.finish || i+1)}</td><td><span class="driver-name">${html(r.display_name)}</span><div class="muted">${html(r.car_name)}</div></td>
                    <td>${html(r.car_number)}</td><td>${html(r.start || '—')}</td><td>${fmtInt(r.laps)}</td><td>${fmtInt(r.led)}</td><td>${fmtInt(r.incidents)}</td><td>${fmtInt(r.points)}</td>
                    <td>${fmtTime(r.bestLap)}</td><td>${fmtTime(r.avgLap)}</td><td class="${delta>0?'positive':delta<0?'negative':''}">${delta===null?'—':delta>0?'+'+delta:delta}</td><td>${html(r.reason)}</td>
                </tr>`;
            }).join('')}</tbody></table>`;
        }

        function renderStandings() {
            const rows = computeStandings(selectedRaces());
            $('standingsTable').innerHTML = rows.length ? `<table><thead><tr><th>Rank</th><th>Driver</th><th>Points</th><th>Wins</th><th>Top 5</th><th>Top 10</th><th>Starts</th><th>Avg Fin</th><th>Laps Led</th><th>Inc</th></tr></thead><tbody>${rows.map((r,i)=>`<tr class="${i<3?'top3':''}" onclick="openDriver(${Number(r.cust_id)})"><td class="rank">${i+1}</td><td><span class="driver-name">${html(r.name)}</span><div class="muted">#${html(r.number || '—')}</div></td><td>${fmtInt(r.points)}</td><td>${fmtInt(r.wins)}</td><td>${fmtInt(r.top5)}</td><td>${fmtInt(r.top10)}</td><td>${fmtInt(r.starts)}</td><td>${r.avgFinish.toFixed(1)}</td><td>${fmtInt(r.led)}</td><td>${fmtInt(r.incidents)}</td></tr>`).join('')}</tbody></table>` : `<div class="empty-state">No standings yet.</div>`;
        }

        function computeStandings(races) {
            const map = new Map();
            for (const race of races) for (const r of race.results) {
                if (!map.has(r.cust_id)) map.set(r.cust_id, { cust_id:r.cust_id, name:r.display_name, number:r.car_number, points:0, wins:0, top5:0, top10:0, starts:0, finishes:0, led:0, incidents:0, logs:[] });
                const d = map.get(r.cust_id);
                d.points += r.points; d.starts++; d.finishes += r.finish || 0; d.led += r.led; d.incidents += r.incidents;
                if (r.finish === 1) d.wins++; if (r.finish <= 5) d.top5++; if (r.finish <= 10) d.top10++;
                d.logs.push({ race, result:r });
            }
            return [...map.values()].map(d => ({...d, avgFinish: d.starts ? d.finishes/d.starts : 0})).sort((a,b)=> b.points-a.points || b.wins-a.wins || a.avgFinish-b.avgFinish);
        }

        function renderDrivers() {
            const rows = computeStandings(selectedRaces());
            $('driverGrid').innerHTML = rows.map(d => `<article class="card driver-card" onclick="openDriver(${Number(d.cust_id)})"><div class="number-watermark">${html(d.number || '')}</div><h3>${html(d.name)}</h3><div class="small">${fmtInt(d.points)} pts • ${fmtInt(d.wins)} wins • ${d.avgFinish.toFixed(1)} avg finish</div><div class="small">${fmtInt(d.starts)} starts • ${fmtInt(d.led)} laps led • ${fmtInt(d.incidents)} incidents</div></article>`).join('') || `<div class="empty-state">No drivers loaded yet.</div>`;
        }

        function renderPositionChart(race) {
            const laps = race.laps;
            if (!laps.length) { $('positionChart').innerHTML = `<div class="empty-state">No lap chart file paired with this race.</div>`; $('chartLegend').innerHTML = ''; return; }
            const topDrivers = [...new Set(laps.filter(l => l.running_position <= 8).map(l => l.cust_id))].slice(0, 8);
            const maxLap = Math.max(...laps.map(l => l.lap_number), 1);
            const maxPos = Math.max(...laps.map(l => l.running_position), race.entries, 1);
            const W = 1000, H = 440, pad = {l:55,r:25,t:25,b:45};
            const x = lap => pad.l + (lap / maxLap) * (W-pad.l-pad.r);
            const y = p => pad.t + ((p-1) / Math.max(1, maxPos-1)) * (H-pad.t-pad.b);
            const colors = ['#00f0ff','#ffd700','#ff4040','#00ff88','#aa66ff','#ff8c00','#ffffff','#ff00d4'];
            const byDriver = new Map();
            for (const id of topDrivers) byDriver.set(id, laps.filter(l => l.cust_id === id).sort((a,b)=>a.lap_number-b.lap_number));
            let lines = '';
            let legend = '';
            [...byDriver.entries()].forEach(([id, arr], idx) => {
                const pts = arr.map(l => `${x(l.lap_number).toFixed(1)},${y(l.running_position).toFixed(1)}`).join(' ');
                const name = arr[0]?.display_name || id;
                lines += `<polyline points="${pts}" fill="none" stroke="${colors[idx]}" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" opacity="0.95"/>`;
                legend += `<span style="border-color:${colors[idx]};color:${colors[idx]}">#${html(arr[0]?.car_number || '')} ${html(name)}</span>`;
            });
            const grid = Array.from({length: 6}, (_,i) => {
                const p = 1 + i * Math.max(1, Math.round((maxPos-1)/5));
                return `<line x1="${pad.l}" y1="${y(p)}" x2="${W-pad.r}" y2="${y(p)}" stroke="#1b1b1b"/><text x="10" y="${y(p)+5}" fill="#777" font-size="14">P${p}</text>`;
            }).join('');
            $('positionChart').innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Position chart"><rect width="${W}" height="${H}" fill="#030607"/>${grid}<line x1="${pad.l}" y1="${H-pad.b}" x2="${W-pad.r}" y2="${H-pad.b}" stroke="#333"/><text x="${W/2}" y="${H-12}" text-anchor="middle" fill="#777" font-size="14">Lap</text><text x="16" y="22" fill="#777" font-size="14">Position</text>${lines}</svg>`;
            $('chartLegend').innerHTML = legend;
        }

        function renderEventFeed(race) {
            const events = race.laps.flatMap(l => l.events.map(e => ({...l, event:e}))).sort((a,b)=>a.lap_number-b.lap_number || a.running_position-b.running_position);
            $('eventFeed').innerHTML = events.length ? events.slice(0, 250).map(e => `<div class="event-item"><div class="event-lap">Lap ${html(e.lap_number)}</div><div>#${html(e.car_number)} ${html(e.display_name)} <span class="muted">P${html(e.running_position)}</span></div><div class="event-tag ${html(e.event)}">${html(String(e.event).replaceAll('_',' '))}</div></div>`).join('') : `<div class="empty-state">No lap events recorded for the selected race.</div>`;
        }

        function openDriver(custId) {
            const d = computeStandings(selectedRaces()).find(x => String(x.cust_id) === String(custId));
            if (!d) return;
            $('modalName').textContent = d.name;
            $('modalSub').textContent = `#${d.number || '—'} • ${d.starts} start(s) • ${d.points} points`;
            $('modalKpis').innerHTML = [['Points',d.points],['Wins',d.wins],['Top 5',d.top5],['Top 10',d.top10],['Avg Fin',d.avgFinish.toFixed(1)],['Laps Led',d.led]].map(([l,v])=>`<div class="kpi"><div class="kpi-label">${l}</div><div class="kpi-value">${v}</div></div>`).join('');
            const logs = d.logs.sort((a,b)=>(b.race.date||'').localeCompare(a.race.date||''));
            $('modalTable').innerHTML = `<table><thead><tr><th>Race</th><th>Finish</th><th>Start</th><th>Laps</th><th>Led</th><th>Inc</th><th>Pts</th><th>Best</th></tr></thead><tbody>${logs.map(x=>`<tr><td><span class="driver-name">${html(x.race.name)}</span><div class="muted">${html(x.race.seasonName)}</div></td><td>${html(x.result.finish)}</td><td>${html(x.result.start || '—')}</td><td>${fmtInt(x.result.laps)}</td><td>${fmtInt(x.result.led)}</td><td>${fmtInt(x.result.incidents)}</td><td>${fmtInt(x.result.points)}</td><td>${fmtTime(x.result.bestLap)}</td></tr>`).join('')}</tbody></table>`;
            $('driverModal').classList.add('open');
        }
        function closeDriverModal(e) { if (e.target.id === 'driverModal') $('driverModal').classList.remove('open'); }

        function seedEmpty() {
            if (!state.races.length) {
                rebuildSeasons();
                renderAll();
            }
        }
        function clearData() {
            state.races = []; state.seasons = []; state.selectedRaceId = null; state.selectedSeason = 'all';
            renderAll(); setStatus('Loaded data cleared from this page session.');
        }
    </script>
</body>
</html>
